{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/dasp-nat-7204-application-form",
      "destination": "/dasp-online-application",
      "permanent": true
    },
    {
      "source": "/assets/DASPA-DASP-Application-Form.pdf",
      "destination": "/dasp-online-application",
      "permanent": true
    },
    {
      "source": "/upload-form",
      "destination": "/id-verification",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/googlec958a1798c20283a.html",
      "destination": "/google-gsc-verification.txt"
    },
    {
      "source": "/wa",
      "destination": "/api/wa"
    }
  ],
  "crons": [
    {
      "path": "/api/claims-sweep",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/id-documents-sweep",
      "schedule": "30 16 * * *"
    }
  ]
}
